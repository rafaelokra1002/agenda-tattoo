# ==========================================================
# Banco de dados PostgreSQL
# ==========================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tatuagem?schema=public"

# ==========================================================
# Servidor
# ==========================================================
PORT=4000
NODE_ENV=development

# Origem permitida para CORS (frontend Next.js)
CORS_ORIGIN="http://localhost:3000"

# ==========================================================
# Autenticação (JWT)
# ==========================================================
JWT_SECRET="troque-por-uma-chave-secreta-bem-longa-e-aleatoria"
JWT_EXPIRES_IN="7d"

# ==========================================================
# Admin criado no seed
# ==========================================================
ADMIN_EMAIL="admin@tattoo.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"

# ==========================================================
# Pagamento PIX
# provider: "fake" (simulado) ou "mercadopago"
# ==========================================================
PAYMENT_PROVIDER="fake"
MERCADOPAGO_ACCESS_TOKEN=""
